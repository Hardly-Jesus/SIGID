@model IReadOnlyList<ProductViewModel>
@{
    ViewData["Title"] = "Productos";
    ViewData["Subtitle"] = Model.Count == 0
        ? "Catálogo de productos del inventario"
        : $"{Model.Count} {(Model.Count == 1 ? "producto registrado" : "productos registrados")}";
}

@section PageActions {
    <a class="btn btn-primary" asp-action="Create"><svg class="icon"><use href="#i-plus" /></svg> Nuevo producto</a>
}

<section class="panel">
    @if (Model.Count == 0)
    {
        <div class="empty">
            <span class="empty-icon"><svg class="icon"><use href="#i-box" /></svg></span>
            <h3>Aún no hay productos</h3>
            <p>Registra el primer producto indicando su SKU, categoría y proveedor. Sus existencias empiezan en cero y aumentan con las entradas de inventario.</p>
            <a class="btn btn-primary" asp-action="Create"><svg class="icon"><use href="#i-plus" /></svg> Registrar producto</a>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th class="col-optional">Proveedor</th>
                        <th>Existencias</th>
                        <th class="text-end col-optional">Mín. / Máx.</th>
                        <th>Estado</th>
                        <th class="text-end"><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <span class="cell-main">@p.Name</span>
                                <span class="cell-sub sku">@p.SKU</span>
                            </td>
                            <td class="secondary">@p.CategoryName</td>
                            <td class="secondary col-optional">@p.SupplierName</td>
                            <td><partial name="_StockMeter" model="p" /></td>
                            <td class="text-end num secondary col-optional">@p.MinimumStock / @p.MaximumStock</td>
                            <td><partial name="_StockChip" model="p" /></td>
                            <td>
                                <div class="actions">
                                    @if (p.IsActive)
                                    {
                                        <a class="icon-button" asp-controller="Inventory" asp-action="CreateEntry" asp-route-productId="@p.Id" title="Registrar entrada" aria-label="Registrar entrada de @p.Name">
                                            <svg class="icon"><use href="#i-entry" /></svg>
                                        </a>
                                        @if (p.CurrentStock > 0)
                                        {
                                            <a class="icon-button" asp-controller="Inventory" asp-action="CreateExit" asp-route-productId="@p.Id" title="Registrar salida" aria-label="Registrar salida de @p.Name">
                                                <svg class="icon"><use href="#i-exit" /></svg>
                                            </a>
                                        }
                                    }
                                    <a class="icon-button" asp-action="Edit" asp-route-id="@p.Id" title="Editar" aria-label="Editar @p.Name">
                                        <svg class="icon"><use href="#i-edit" /></svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
