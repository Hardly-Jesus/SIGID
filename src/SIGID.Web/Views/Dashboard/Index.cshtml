@{
    ViewData["Title"] = "Dashboard";
    var indicators = new[]
    {
        "Total de productos",
        "Productos con stock bajo",
        "Ventas del mes",
        "Alertas activas"
    };
}

<div class="mb-4">
    <h1 class="h3 mb-0">SIGID</h1>
    <p class="text-muted mb-1">Sistema Inteligente de Gestión de Inventarios y Demanda</p>
    <h2 class="h4">Dashboard</h2>
</div>

<div class="row g-3 mb-4">
    @foreach (var indicator in indicators)
    {
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card h-100 placeholder-card">
                <div class="card-body">
                    <h3 class="h6 card-title text-muted">@indicator</h3>
                    <p class="display-6 mb-0">—</p>
                    <small class="text-muted">Indicador pendiente</small>
                </div>
            </div>
        </div>
    }
</div>

<div class="row g-3">
    <div class="col-12 col-lg-8">
        <div class="card h-100 placeholder-card">
            <div class="card-body">
                <h3 class="h6 card-title">Tendencia de demanda</h3>
                <div class="placeholder-area">Espacio reservado para el gráfico de demanda</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card h-100 placeholder-card">
            <div class="card-body">
                <h3 class="h6 card-title">Alertas recientes</h3>
                <div class="placeholder-area">Espacio reservado para alertas</div>
            </div>
        </div>
    </div>
</div>
