@model IReadOnlyList<CategoryViewModel>
@{
    ViewData["Title"] = "Categorías";
    ViewData["Subtitle"] = "Clasificación de los productos del inventario";
}

@section PageActions {
    <a class="btn btn-primary" asp-action="Create"><svg class="icon"><use href="#i-plus" /></svg> Nueva categoría</a>
}

<section class="panel">
    @if (Model.Count == 0)
    {
        <div class="empty">
            <span class="empty-icon"><svg class="icon"><use href="#i-tag" /></svg></span>
            <h3>Aún no hay categorías</h3>
            <p>Las categorías organizan el catálogo. Crea al menos una antes de registrar productos.</p>
            <a class="btn btn-primary" asp-action="Create"><svg class="icon"><use href="#i-plus" /></svg> Crear categoría</a>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th class="col-optional">Descripción</th>
                        <th class="text-end">Productos</th>
                        <th>Estado</th>
                        <th class="text-end"><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><span class="cell-main">@c.Name</span></td>
                            <td class="secondary col-optional">@(string.IsNullOrEmpty(c.Description) ? "—" : c.Description)</td>
                            <td class="text-end"><span class="count-pill">@c.ProductCount</span></td>
                            <td><partial name="_ActiveChip" model="c.IsActive" /></td>
                            <td>
                                <div class="actions">
                                    <a class="icon-button" asp-action="Edit" asp-route-id="@c.Id" title="Editar" aria-label="Editar @c.Name">
                                        <svg class="icon"><use href="#i-edit" /></svg>
                                    </a>
                                    <a class="icon-button is-danger" asp-action="Delete" asp-route-id="@c.Id" title="Eliminar" aria-label="Eliminar @c.Name">
                                        <svg class="icon"><use href="#i-trash" /></svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
