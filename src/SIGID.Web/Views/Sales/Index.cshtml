@using SIGID.Web.Extensions
@model SaleHistoryViewModel
@{
    ViewData["Title"] = "Historial de ventas";
    ViewData["Subtitle"] = "Ventas registradas, de la más reciente a la más antigua";
    var filterError = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage
        ?? ViewData.ModelState["StartDate"]?.Errors.FirstOrDefault()?.ErrorMessage;
}

@section PageActions {
    <a class="btn btn-primary" asp-action="Create"><svg class="icon"><use href="#i-plus" /></svg> Registrar venta</a>
}

<section class="panel">
    <form method="get" asp-action="Index" class="filters filters-sales" role="search">
        <div class="field">
            <label class="field-label" for="productId">Producto</label>
            <select class="select" id="productId" name="productId">
                <option value="">Todos los productos</option>
                @foreach (var p in Model.Products)
                {
                    <option value="@p.Id" selected="@(p.Id == Model.ProductId)">@p.SKU — @p.Name</option>
                }
            </select>
        </div>
        <div class="field">
            <label class="field-label" for="from">Desde</label>
            <input class="input" type="date" id="from" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="field">
            <label class="field-label" for="to">Hasta</label>
            <input class="input" type="date" id="to" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="filters-actions">
            <button type="submit" class="btn btn-primary"><svg class="icon"><use href="#i-filter" /></svg> Filtrar</button>
            @if (Model.HasFilters)
            {
                <a class="btn btn-quiet" asp-action="Index">Limpiar</a>
            }
        </div>
    </form>

    @if (filterError is not null)
    {
        <div class="notice notice-error" style="margin: 0 22px 18px;">
            <svg class="icon"><use href="#i-alert" /></svg><span>@filterError</span>
        </div>
    }

    @if (Model.Sales.Count == 0)
    {
        <div class="empty" style="border-top: 1px solid var(--border);">
            <span class="empty-icon"><svg class="icon"><use href="#i-receipt" /></svg></span>
            @if (Model.HasFilters)
            {
                <h3>No se encontraron ventas con estos filtros</h3>
                <p>Prueba con otro producto o un rango de fechas más amplio.</p>
                <a class="btn btn-secondary" asp-action="Index">Ver todas las ventas</a>
            }
            else
            {
                <h3>Aún no hay ventas registradas</h3>
                <p>Las ventas que registres aparecerán aquí, ordenadas de la más reciente a la más antigua.</p>
                <a class="btn btn-primary" asp-action="Create"><svg class="icon"><use href="#i-plus" /></svg> Registrar venta</a>
            }
        </div>
    }
    else
    {
        <div class="result-bar" style="border-bottom: 1px solid var(--border);">
            <span><strong>@Model.Sales.Count</strong> @(Model.Sales.Count == 1 ? "venta" : "ventas")@(Model.HasFilters ? " con los filtros aplicados" : "")</span>
        </div>
        <div class="table-wrap">
            <table class="table sale-history">
                <thead>
                    <tr>
                        <th>N.º</th>
                        <th>Fecha</th>
                        <th>Productos vendidos</th>
                        <th class="text-end">Total</th>
                        <th class="text-end"><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.Sales)
                    {
                        <tr>
                            <td class="num"><a class="cell-main" asp-action="Details" asp-route-id="@s.Id">Venta #@s.Id</a></td>
                            <td class="nowrap">
                                <span class="cell-main num">@s.Date.ToString("dd/MM/yyyy")</span>
                                <span class="cell-sub num">@s.Date.ToString("HH:mm")</span>
                            </td>
                            <td>
                                @{
                                    // Hasta 3 productos a la vista; si hay más, se muestran 2 y un indicador.
                                    var shown = s.Items.Count <= 3 ? s.Items.Count : 2;
                                    var more = s.Items.Count - shown;
                                }
                                <ul class="sale-items">
                                    @foreach (var item in s.Items.Take(shown))
                                    {
                                        <li><span class="sale-item-name">@item.ProductName</span> <span class="sale-item-qty num">@item.Quantity @item.UnitOfMeasure</span></li>
                                    }
                                    @if (more > 0)
                                    {
                                        <li><a class="sale-items-more" asp-action="Details" asp-route-id="@s.Id">+@more productos más</a></li>
                                    }
                                </ul>
                            </td>
                            <td class="text-end nowrap">
                                @* Se suma por unidad de medida; no se mezclan unidades distintas. *@
                                <span class="cell-main num">@QuantityFormat.TotalsByUnit(s.Items.Select(i => (i.Quantity, i.UnitOfMeasure)))</span>
                                <span class="cell-sub">@QuantityFormat.Products(s.ProductCount)</span>
                            </td>
                            <td>
                                <div class="actions">
                                    <a class="icon-button" asp-action="Details" asp-route-id="@s.Id" title="Ver detalle" aria-label="Ver detalle de la venta #@s.Id">
                                        <svg class="icon"><use href="#i-chevron" /></svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
