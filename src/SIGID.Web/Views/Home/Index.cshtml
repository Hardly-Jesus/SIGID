@{
    ViewData["Title"] = "Inicio";
}

<section class="panel welcome">
    <div>
        <h2>Sistema Inteligente de Gestión de Inventarios y Demanda</h2>
        <p>Organiza el catálogo, registra cada entrada y salida de mercadería y consulta en cualquier momento las existencias reales de tus productos.</p>
        <div class="welcome-actions">
            <a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index"><svg class="icon"><use href="#i-dashboard" /></svg> Ir al dashboard</a>
            <a class="btn btn-secondary" asp-controller="Products" asp-action="Index">Ver productos</a>
        </div>
    </div>

    @* Orden recomendado para empezar a usar el sistema: sí es una secuencia. *@
    <ol class="flow" aria-label="Primeros pasos">
        <li>
            <span class="step">1</span>
            <div><strong><a asp-controller="Categories" asp-action="Index">Categorías y proveedores</a></strong><span>Crea la clasificación y quién abastece cada producto.</span></div>
        </li>
        <li>
            <span class="step">2</span>
            <div><strong><a asp-controller="Products" asp-action="Index">Productos</a></strong><span>Registra el catálogo con su SKU y sus umbrales de stock.</span></div>
        </li>
        <li>
            <span class="step">3</span>
            <div><strong><a asp-controller="Inventory" asp-action="Entries">Entradas y salidas</a></strong><span>Cada movimiento actualiza las existencias y queda en el historial.</span></div>
        </li>
    </ol>
</section>
